<Window x:Class="ClipCanvasMirror.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#55000000"
        ShowInTaskbar="False" Topmost="True" Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
  <Canvas x:Name="SelectionCanvas">
    <Border x:Name="SelectionBorder" Visibility="Collapsed"
            BorderBrush="#36C5F0" BorderThickness="2" Background="#2236C5F0"/>
    <Border Canvas.Left="20" Canvas.Top="20" Background="#CC111318" Padding="12,8">
      <TextBlock Foreground="White" FontSize="15"
                 Text="表示したいキャンバス範囲をドラッグしてください　（Escでキャンセル）"/>
    </Border>
  </Canvas>
</Window>

