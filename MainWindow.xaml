<Window x:Class="ClipCanvasMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip Canvas Mirror" Width="1040" Height="620"
        MinWidth="120" MinHeight="80"
        Background="#181A1F">
  <DockPanel>
    <Border x:Name="SettingsBar" DockPanel.Dock="Top" Background="#24272E" Padding="10">
      <DockPanel LastChildFill="True">
        <Button x:Name="ToggleSettingsButton" DockPanel.Dock="Right"
                Content="設定をしまう" Click="ToggleSettings_Click"
                Padding="10,5" Margin="10,0,0,0"
                VerticalAlignment="Top"/>
        <WrapPanel x:Name="SettingsControls" VerticalAlignment="Center">
        <Button x:Name="SelectRegionButton" Content="範囲を選択" Click="SelectRegion_Click"
                Padding="14,6" Margin="0,0,8,0"/>
        <ToggleButton x:Name="PauseButton" Content="一時停止" Click="Pause_Click"
                      Padding="14,6" Margin="0,0,14,0"/>
        <TextBlock Text="表示" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="LayoutComboBox" Width="92" SelectionChanged="Layout_Changed" Margin="0,0,14,0">
          <ComboBoxItem Content="横並び" Tag="Horizontal"/>
          <ComboBoxItem Content="縦並び" Tag="Vertical"/>
        </ComboBox>
        <TextBlock Text="更新" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="FpsComboBox" Width="154" SelectionChanged="Fps_Changed" Margin="0,0,14,0"
                  ToolTip="数値が大きいほど滑らかに更新されますが、PCへの負荷も高くなります">
          <ComboBoxItem Content="0.5 fps（負荷最低）" Tag="0.5"/>
          <ComboBoxItem Content="1 fps（負荷最低）" Tag="1"/>
          <ComboBoxItem Content="2 fps（負荷低）" Tag="2"/>
          <ComboBoxItem Content="5 fps（負荷低）" Tag="5"/>
          <ComboBoxItem Content="10 fps（負荷普通）" Tag="10"/>
          <ComboBoxItem Content="15 fps（負荷普通）" Tag="15"/>
          <ComboBoxItem Content="30 fps（負荷高）" Tag="30"/>
        </ComboBox>
        <CheckBox x:Name="TopmostCheckBox" Content="常に手前" Foreground="#E8E8E8"
                  VerticalAlignment="Center" Checked="Topmost_Changed" Unchecked="Topmost_Changed"
                  Margin="0,0,14,0"/>
        <TextBlock Text="表示内容" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <CheckBox x:Name="ShowMirrorCheckBox" Content="左右反転" Foreground="#E8E8E8"
                  VerticalAlignment="Center" Margin="0,0,8,0"
                  Checked="PreviewVisibility_Changed" Unchecked="PreviewVisibility_Changed"/>
        <CheckBox x:Name="ShowGrayCheckBox" Content="明暗確認" Foreground="#E8E8E8"
                  VerticalAlignment="Center" Margin="0,0,8,0"
                  Checked="PreviewVisibility_Changed" Unchecked="PreviewVisibility_Changed"/>
        <Button x:Name="SwapButton" Content="順番を入れ替え" Click="Swap_Click"
                Padding="10,5" Margin="0,0,14,0"/>
        <TextBlock Text="明暗確認方法" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="AnalysisModeComboBox" Width="176"
                  SelectionChanged="AnalysisMode_Changed"
                  ToolTip="明暗や色の確認方法を切り替えます">
          <ComboBoxItem Content="知覚輝度（基本）" Tag="PerceptualLuminance"/>
          <ComboBoxItem Content="彩度0（HSL）" Tag="HslDesaturation"/>
          <ComboBoxItem Content="3階調" Tag="ThreeTone"/>
          <ComboBoxItem Content="5階調" Tag="FiveTone"/>
          <ComboBoxItem Content="ぼかし＋知覚輝度" Tag="BlurredLuminance"/>
          <ComboBoxItem Content="カラー（通常）" Tag="OriginalColor"/>
        </ComboBox>
        </WrapPanel>
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#24272E" Foreground="#D8D8D8">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="「範囲を選択」でキャンバスを囲んでください"/>
      </StatusBarItem>
    </StatusBar>

    <Grid x:Name="PreviewGrid" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition Height="0"/>
      </Grid.RowDefinitions>

      <Border x:Name="MirrorPanel" Grid.Column="0" Grid.Row="0" Margin="0,0,4,0"
              BorderBrush="#3A3E48" BorderThickness="1" Background="#101216"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="MirrorImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                 Cursor="Hand" ToolTip="ホイール: 拡大縮小 / 左ドラッグ: 移動 / ダブルクリック: リセット"
                 PreviewMouseWheel="Preview_MouseWheel"
                 MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                 MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                 MouseMove="Preview_MouseMove"/>
          <Border Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3">
            <TextBlock Text="左右反転" Foreground="White"/>
          </Border>
        </Grid>
      </Border>
      <Border x:Name="GrayPanel" Grid.Column="1" Grid.Row="0" Margin="4,0,0,0"
              BorderBrush="#3A3E48" BorderThickness="1" Background="#101216"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="GrayImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                 Cursor="Hand" ToolTip="ホイール: 拡大縮小 / 左ドラッグ: 移動 / ダブルクリック: リセット"
                 PreviewMouseWheel="Preview_MouseWheel"
                 MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                 MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                 MouseMove="Preview_MouseMove"/>
          <Border Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3">
            <TextBlock x:Name="AnalysisLabel" Text="知覚輝度" Foreground="White"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>

